{
  "name": "dsh-plugin-lifecycle",
  "version": "0.1.0",
  "description": "A DSH plugin that infers whether installed plugins are still in use from observable signals, auto-disables dormant ones, and restores them instantly when needed.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "locale",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.js",
    "check": "node --check lib/index.js && node --check lib/bayes.js && node --check lib/state-machine.js",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin-manager",
    "plugin-lifecycle",
    "bayesian"
  ],
  "license": "MIT",
  "engines": {
    "dsh": ">=0.2.0-rc.2 <0.3.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SSHOOTING/dsh-plugin-lifecycle.git"
  },
  "homepage": "https://github.com/SSHOOTING/dsh-plugin-lifecycle#readme",
  "bugs": {
    "url": "https://github.com/SSHOOTING/dsh-plugin-lifecycle/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/cordis-plugin-timer": "~1.1.6",
    "@deepseek-ai/dsh-commands": "0.2.0-rc.2",
    "@deepseek-ai/dsh-plugin-manager": "0.2.0-rc.2",
    "@deepseek-ai/dsh-sandbox": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session": "0.2.0-rc.2",
    "@deepseek-ai/dsh-storage-domain": "0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.4",
    "zod": "^4.6.5"
  }
}
